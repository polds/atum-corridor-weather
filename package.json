{
  "name": "corridor-weather",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial open-source prober and public dashboard for Atum quote corridors. Not an official Atum product.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run build:dashboard && wrangler dev --test-scheduled",
    "build": "pnpm run build:dashboard && wrangler deploy --dry-run --outdir dist/worker",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:migrate:local": "wrangler d1 migrations apply corridor-weather --local",
    "probe-identity": "node scripts/derive-probe-identity.mjs"
  },
  "dependencies": {
    "@atumlabs/payment-gateway-client": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "esbuild": "^0.28.2",
    "ethers": "^6.17.0",
    "typescript": "^5.9.3",
    "uplot": "^1.6.32",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@biomejs/biome",
      "sharp"
    ]
  }
}
