{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corridor-weather",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// The probe cron runs a tick. The canary cron, two minutes later, announces alert
	// changes. scheduled() tells them apart by PROBE_CRON and CANARY_CRON and ignores
	// any other trigger, so keep these two entries equal to those two vars.
	"triggers": { "crons": ["*/5 * * * *", "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"] },
	"assets": {
		"directory": "dist/dashboard",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/metrics"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corridor-weather",
			// Replace with the id that `wrangler d1 create corridor-weather` prints. See docs/RUNBOOK.md.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"NETWORK": "testnet",
		"GATEWAY_URL": "https://payment-gw.production-testnet.atum.xyz",
		"PROBE_ENABLED": "true",
		"TICK_INTERVAL_MINUTES": "5",
		"PROBES_PER_TICK": "30",
		"AMOUNT_TIERS": "{\"small\":\"1\",\"typical\":\"25\",\"large\":\"100\"}",
		"POLL_INTERVAL_MS": "500",
		"QUOTE_WINDOW_SECONDS": "3",
		"SLOW_QUOTE_MS": "2500",
		"RAW_RETENTION_DAYS": "14",
		"CORRIDOR_FILTER": "",
		"MAINNET_ACK": "",
		"REPOSITORY_URL": "https://github.com/polds/atum-corridor-weather",
		"PROBE_CRON": "*/5 * * * *",
		"CANARY_CRON": "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
		// ALERT_WEBHOOK_URL is a secret: `wrangler secret put ALERT_WEBHOOK_URL`.
		"ALERT_WEBHOOK_FORMAT": "slack",
		"ALERT_MIN_SEVERITY": "critical",
		"PUBLIC_URL": ""
	}
}
