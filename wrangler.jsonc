{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corridor-weather",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// The probe cron runs a tick. The canary cron, a few minutes after each publish,
	// announces alert changes. scheduled() tells them apart by PROBE_CRON and CANARY_CRON
	// and ignores any other trigger, so keep these two entries equal to those two vars.
	// The tick interval is read from PROBE_CRON. To change the cadence, change these two
	// entries, those two vars and PUBLISH_EVERY_TICKS, and nothing else.
	"triggers": { "crons": ["*/2 * * * *", "2,12,22,32,42,52 * * * *"] },
	"assets": {
		"directory": "dist/dashboard",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/metrics"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corridor-weather",
			// A placeholder. Do not commit a real id. A deploy takes the id from the
			// D1_DATABASE_ID variable through scripts/render-deploy-config.mjs. See docs/RUNBOOK.md.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"NETWORK": "testnet",
		"GATEWAY_URL": "https://payment-gw.production-testnet.atum.xyz",
		"PROBE_ENABLED": "true",
		// Probes per tick. 6 is what SUBREQUEST_LIMIT 50 covers: 6 every 2 minutes is 180 an hour.
		"PROBES_PER_TICK": "6",
		// Subrequests one invocation may make. 50 is the Workers Free limit; the Workers Paid
		// limit is 10,000. A tick plans no more probes than this covers (docs/DESIGN.md,
		// "Platform limits").
		"SUBREQUEST_LIMIT": "50",
		// A tick rebuilds the snapshot when its slot index is a multiple of this. 5 ticks of
		// 2 minutes publish every 10 minutes, at :00, :10 and so on, which keeps D1 rows read
		// within the Workers Free limit. The dashboard and the alerts update once per publish.
		"PUBLISH_EVERY_TICKS": "5",
		"AMOUNT_TIERS": "{\"small\":\"1\",\"typical\":\"25\",\"large\":\"100\"}",
		"POLL_INTERVAL_MS": "500",
		"QUOTE_WINDOW_SECONDS": "3",
		"SLOW_QUOTE_MS": "2500",
		"RAW_RETENTION_DAYS": "14",
		"CORRIDOR_FILTER": "",
		"MAINNET_ACK": "",
		"REPOSITORY_URL": "https://github.com/polds/atum-corridor-weather",
		"PROBE_CRON": "*/2 * * * *",
		// Two minutes after each publish, so the canary reads a fresh snapshot.
		"CANARY_CRON": "2,12,22,32,42,52 * * * *",
		// ALERT_WEBHOOK_URL is a secret: `wrangler secret put ALERT_WEBHOOK_URL`.
		"ALERT_WEBHOOK_FORMAT": "slack",
		"ALERT_MIN_SEVERITY": "critical",
		"PUBLIC_URL": ""
	}
}
